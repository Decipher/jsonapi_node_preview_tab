<?php

/**
 * @file
 * Primary module hooks for JSON:API Node Preview Tab module.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\jsonapi_node_preview_tab\Hook\JsonapiNodePreviewTabHooks;

/**
 * Implements hook_entity_type_build().
 */
#[LegacyHook]
function jsonapi_node_preview_tab_entity_type_build(array &$entity_types): void {
  \Drupal::service(JsonapiNodePreviewTabHooks::class)->entityTypeBuild($entity_types);
}

/**
 * Implements hook_entity_operation().
 */
#[LegacyHook]
function jsonapi_node_preview_tab_entity_operation(EntityInterface $entity, ?CacheableMetadata $cacheability = NULL): array {
  return \Drupal::service(JsonapiNodePreviewTabHooks::class)->entityOperation($entity, $cacheability);
}
